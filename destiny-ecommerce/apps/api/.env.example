# ===== DESTINY E-COMMERCE API — Environment Variables =====
# Copy this file to .env and fill in your values

# App Configuration
NODE_ENV=production
PORT=5000
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Database — get from Supabase/Neon/Railway
DATABASE_URL=postgresql://user:password@host:5432/destiny_db?schema=public&sslmode=require

# JWT Secrets — generate: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_DO_NOT_REUSE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (optional)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Cloudinary — Image Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email — SMTP (SendGrid recommended)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key
SMTP_FROM_EMAIL=hello@destiny-ecommerce.com
SMTP_FROM_NAME=Destiny E-Commerce

# SMS — Africa's Talking (optional, gracefully disabled if missing)
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-username
AT_SENDER_ID=Destiny

# Firebase Push Notifications (optional)
FIREBASE_SERVICE_ACCOUNT=/path/to/firebase-service-account.json

# MTN MoMo API (optional — manual verification mode works without this)
# Your manual number: 653526767 | USSD: *126*4*1*653526767*AMOUNT#
MTN_MOMO_API_KEY=your-mtn-momo-api-key
MTN_MOMO_SUBSCRIPTION_KEY=your-subscription-key
MTN_MOMO_ENVIRONMENT=production

# Orange Money API (optional — manual verification mode works without this)
# Your manual number: 640638536 (Cho Clinton Teneng)
ORANGE_CLIENT_ID=your-orange-client-id
ORANGE_CLIENT_SECRET=your-orange-client-secret

# Elasticsearch (optional — PostgreSQL full-text search is used as fallback)
ELASTICSEARCH_URL=https://your-cluster.es.io:9243

# Redis (optional — for caching)
REDIS_URL=redis://default:password@redis-host:6379

# Google Maps (optional — for delivery tracking)
GOOGLE_MAPS_API_KEY=your-maps-api-key
