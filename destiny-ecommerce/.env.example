# ============================================
# DESTINY E-COMMERCE — Environment Variables
# ============================================

# ---- APP ----
NODE_ENV=development
APP_NAME="Destiny E-Commerce"
APP_URL=https://destinyecommerce.cm
API_URL=https://api.destinyecommerce.cm

# ---- DATABASE ----
DATABASE_URL="postgresql://destiny_user:your_password@localhost:5432/destiny_ecommerce"
POSTGRES_DB=destiny_ecommerce
POSTGRES_USER=destiny_user
POSTGRES_PASSWORD=your_secure_password_here

# ---- REDIS ----
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_PASSWORD=your_redis_password

# ---- JWT ----
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_chars_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ---- NEXTAUTH ----
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# ---- GOOGLE OAUTH ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ---- FACEBOOK OAUTH ----
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ---- CLOUDINARY ----
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- EMAIL (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Destiny E-Commerce <noreply@destinyecommerce.cm>"

# ---- SMS (Africa's Talking) ----
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username
AT_SENDER_ID=DESTINY

# ---- FIREBASE (Push Notifications) ----
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ---- PAYMENTS ----
# MTN Mobile Money (Cameroon)
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_API_USER=your_mtn_api_user_uuid
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENV=sandbox

# Orange Money (Cameroon)
ORANGE_MONEY_MERCHANT_KEY=your_orange_merchant_key
ORANGE_MONEY_SECRET=your_orange_secret

# Stripe (International Cards)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ---- ELASTICSEARCH ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=destiny_

# ---- RATE LIMITING ----
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60

# ---- FRONTEND ----
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="Destiny E-Commerce"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=FCFA

# ---- WHATSAPP ----
WHATSAPP_PHONE=+237650000000
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token

# ---- MONITORING ----
SENTRY_DSN=your_sentry_dsn
